# ============================================================================
# Landly Backend Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables use LANDLY_ prefix and are loaded by Viper.
# Format: LANDLY_<SECTION>_<SUBSECTION>_<FIELD>
# Example: LANDLY_DATABASE_POSTGRES_HOST
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
LANDLY_APP_ENV=development
LANDLY_APP_NAME=landly
LANDLY_APP_VERSION=1.0.0
LANDLY_APP_BASE_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
# For serverless (Yandex Cloud), PORT is set automatically by the platform
# PORT=8080
LANDLY_SERVER_HTTP_ADDR=:8080
LANDLY_SERVER_HTTP_READ_TIMEOUT=30s
LANDLY_SERVER_HTTP_WRITE_TIMEOUT=30s

# CORS (comma-separated for multiple origins in env, but Viper needs proper format)
# LANDLY_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ----------------------------------------------------------------------------
# Authentication (REQUIRED in production)
# ----------------------------------------------------------------------------
# JWT secret must be at least 32 characters
# Generate with: openssl rand -base64 32
LANDLY_AUTH_JWT_SECRET=dev-secret-change-in-production-please-32chars
LANDLY_AUTH_JWT_ACCESS_TOKEN_TTL=15m
LANDLY_AUTH_JWT_REFRESH_TOKEN_TTL=168h

# ----------------------------------------------------------------------------
# PostgreSQL Database (REQUIRED)
# ----------------------------------------------------------------------------
LANDLY_DATABASE_POSTGRES_HOST=localhost
LANDLY_DATABASE_POSTGRES_PORT=5432
LANDLY_DATABASE_POSTGRES_USER=landly
LANDLY_DATABASE_POSTGRES_PASSWORD=landly
LANDLY_DATABASE_POSTGRES_DBNAME=landly
LANDLY_DATABASE_POSTGRES_SSLMODE=disable
LANDLY_DATABASE_POSTGRES_MAX_OPEN_CONNS=25
LANDLY_DATABASE_POSTGRES_MAX_IDLE_CONNS=5
LANDLY_DATABASE_POSTGRES_CONN_MAX_LIFETIME=5m

# ----------------------------------------------------------------------------
# Redis (optional)
# ----------------------------------------------------------------------------
LANDLY_DATABASE_REDIS_ADDR=localhost:6379
LANDLY_DATABASE_REDIS_PASSWORD=
LANDLY_DATABASE_REDIS_DB=0
LANDLY_DATABASE_REDIS_POOL_SIZE=10

# ----------------------------------------------------------------------------
# S3 Storage (REQUIRED)
# ----------------------------------------------------------------------------
# For local development, use MinIO
# For production, use Yandex Object Storage or any S3-compatible service
LANDLY_STORAGE_S3_ENDPOINT=localhost:9000
LANDLY_STORAGE_S3_ACCESS_KEY=minioadmin
LANDLY_STORAGE_S3_SECRET_KEY=minioadmin
LANDLY_STORAGE_S3_BUCKET=landly-sites
LANDLY_STORAGE_S3_USE_SSL=false
LANDLY_STORAGE_S3_REGION=us-east-1

# CDN (optional)
LANDLY_STORAGE_CDN_BASE_URL=http://localhost:9000/landly-sites
LANDLY_STORAGE_CDN_ENABLED=false

# ----------------------------------------------------------------------------
# AI Provider
# ----------------------------------------------------------------------------
# Options: mock, openai, anthropic
LANDLY_AI_PROVIDER=mock

# OpenAI (if provider=openai)
LANDLY_AI_OPENAI_API_KEY=
LANDLY_AI_OPENAI_MODEL=gpt-4
LANDLY_AI_OPENAI_MAX_TOKENS=4000
LANDLY_AI_OPENAI_TEMPERATURE=0.7

# Anthropic (if provider=anthropic)
LANDLY_AI_ANTHROPIC_API_KEY=
LANDLY_AI_ANTHROPIC_MODEL=claude-3-opus-20240229
LANDLY_AI_ANTHROPIC_MAX_TOKENS=4000

# ----------------------------------------------------------------------------
# Render
# ----------------------------------------------------------------------------
LANDLY_RENDER_TMP_DIR=/tmp/landly
LANDLY_RENDER_CLEANUP_AFTER=1h

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LANDLY_LOGGING_LEVEL=info
LANDLY_LOGGING_FORMAT=json
LANDLY_LOGGING_OUTPUT=stdout

# ----------------------------------------------------------------------------
# Observability (optional)
# ----------------------------------------------------------------------------
LANDLY_OBSERVABILITY_METRICS_ENABLED=false
LANDLY_OBSERVABILITY_METRICS_PORT=9090
LANDLY_OBSERVABILITY_TRACING_ENABLED=false
LANDLY_OBSERVABILITY_TRACING_ENDPOINT=
LANDLY_OBSERVABILITY_TRACING_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# Bootstrap Mode (for serverless health checks)
# ----------------------------------------------------------------------------
# Set to 1 to skip required env var validation (allows startup without DB/S3)
# LANDLY_BOOTSTRAP_MODE=1
