# ============================================================================
# Landly Backend - Production Environment (Yandex Cloud)
# ============================================================================
# These are the REQUIRED variables for Yandex Serverless Containers.
# PORT is set automatically by the platform.
# ============================================================================

# Authentication (REQUIRED - min 32 chars)
LANDLY_AUTH_JWT_SECRET=your-production-jwt-secret-at-least-32-characters

# PostgreSQL (REQUIRED - Yandex Managed PostgreSQL)
LANDLY_DATABASE_POSTGRES_HOST=rc1a-xxxxxxxxxx.mdb.yandexcloud.net
LANDLY_DATABASE_POSTGRES_PORT=6432
LANDLY_DATABASE_POSTGRES_USER=landly
LANDLY_DATABASE_POSTGRES_PASSWORD=your-db-password
LANDLY_DATABASE_POSTGRES_DBNAME=landly
LANDLY_DATABASE_POSTGRES_SSLMODE=require

# S3 Storage (REQUIRED - Yandex Object Storage)
LANDLY_STORAGE_S3_ENDPOINT=storage.yandexcloud.net
LANDLY_STORAGE_S3_ACCESS_KEY=YCAJExxxxxxxxxxxxxxxxxx
LANDLY_STORAGE_S3_SECRET_KEY=YCPxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANDLY_STORAGE_S3_BUCKET=landly-sites
LANDLY_STORAGE_S3_USE_SSL=true
LANDLY_STORAGE_S3_REGION=ru-central1

# CDN (optional)
LANDLY_STORAGE_CDN_BASE_URL=https://landly-sites.storage.yandexcloud.net
LANDLY_STORAGE_CDN_ENABLED=true

# Application
LANDLY_APP_ENV=production
LANDLY_APP_BASE_URL=https://api.landly.ru

# AI Provider
LANDLY_AI_PROVIDER=mock
